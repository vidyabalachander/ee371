module counter();
	
	input logic reset;
	input logic [25:0] counter;
	input logic [4:0] addr;
	output logic [4:0] curr_addr
	
    always_ff @(posedge CLOCK_50) begin
        if (reset) begin
            counter <= 0;
            read_addr <= 0;
        end
        else if (counter == 26'd49_999_999) begin
            counter <= 0;
            read_addr <= read_addr + 5'd1;
        end
        else begin
            counter <= counter + 26'd1;
        end
    end
	 
	 curr_addr <= addr;
	
endmodule 