module display (input logic [2:0] count,
					output logic [6:0] HEX0, HEX1, HEX2, HEX3, HEX4, HEX5);
					
	always_comb begin
		case (count)
			000: begin
				HEX5 = 7'b0110001; // C
				HEX4 = 7'b1110001; // L
				HEX3 = 7'b0110000; // E
				HEX2 = 7'b0001000; // A
				HEX1 = 7'b1111010; // r
				HEX0 = 7'b0000001; // 0
			end
			001: begin
				HEX1 = 7'b0000001; // 0
				HEX0 = 7'b1001111; // 1
			end
			010: begin
				HEX1 = 7'b0000001; // 0
				HEX0 = 7'b0010010; // 2
			end
			011: begin
				HEX1 = 7'b0000001; // 0
				HEX0 = 7'b0000110; // 3
			end
			100: begin
				HEX1 = 7'b0000001; // 0
				HEX0 = 7'b1001100; // 4
			end
			101: begin
				HEX5 = 7'b0111000; // F
				HEX4 = 7'b1000001; // U
				HEX3 = 7'b1110001; // L
				HEX2 = 7'b1110001; // L
				HEX1 = 7'b0000001; // 0
				HEX0 = 7'b0100100; // 5
			end
			default: begin
				HEX5 = 7'b1111111;
				HEX4 = 7'b1111111;
				HEX3 = 7'b1111111;
				HEX2 = 7'b1111111;
				HEX1 = 7'b1111111;
				HEX0 = 7'b1111111;
			end
	end
	
endmodule
