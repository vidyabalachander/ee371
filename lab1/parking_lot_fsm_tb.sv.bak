/* Testbench for parking_lot_fsm */
module parking_lot_fsm_tb();
	
	logic clk, reset, x, y, S;
	
	parking_lot_fsm dut (.*);
	
	parameter period = 100;
	initial begin
		clk <= 0;
		forever
			#(period/2)
			clk <= ~clk;
	end

	// The testbench tests all possible transitions.
	initial begin
		// resetting to S0
		reset <= 1;	x <= 0;	y <= 0; @(posedge clk);
		reset <= 0;	x <= 0;	y <= 0; @(posedge clk);
		
						// stay in S0, S = 0
						x <= 0;	y <= 0; @(posedge clk);
						// stay in S0, S = 1
						x <= 0;	y <= 1; @(posedge clk); 
						// stay in S0, S = 1
						x <= 1;	y <= 0; @(posedge clk);
						// transition from S0 -> S1, S = 0
						x <= 1;	y <= 1; @(posedge clk);
						// stay in S1, S = 0
						x <= 0;	y <= 1; @(posedge clk);
						// stay in S1, S = 0
						x <= 1;	y <= 0; @(posedge clk);
						// stay in S1, S = 1
						x <= 1;	y <= 1; @(posedge clk);
						// transition from S1 -> S0, S = 1
						x <= 0;	y <= 0; @(posedge clk);
						
												@(posedge clk);
		$stop;
		
	end
	
endmodule  // hw1p1_tb
