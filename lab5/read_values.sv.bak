module read_values(clk, address, x0, y0, x1, y1);
	input  logic        clk;
   input  logic [7:0]  address;
   output logic [10:0] x0, y0, x1, y1;

   logic [37:0] rom_word;

   rom_lineart memory (.clock(clk), .*);

   // Read the selected line on the rising edge.
   always_ff @(posedge clk) begin
      rom_word <= memory[address];
   end
	
   // Zero-extend each coordinate to the line_drawer's 11-bit port.
   assign x0 = {1'b0,  rom_word[37:28]};
   assign y0 = {2'b00, rom_word[27:19]};
   assign x1 = {1'b0,  rom_word[18:9]};
   assign y1 = {2'b00, rom_word[8:0]};

endmodule  // line_rom